@page "/"
@using Meteor_Web_App.Models
@using Meteor_Web_App.Services
@using System.ComponentModel.DataAnnotations
@implements IDisposable
@inject ArticleService ArticleService
@inject ProductService ProductService
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="home-container">

    <!-- LANZAMIENTOS (CAROUSEL) -->
    <section id="lanzamientos" class="mc-section p-0">
        <div id="carouselMeteor" class="carousel slide" data-bs-ride="carousel">
            @{
                int totalSlides = (productos?.Count() ?? 0) + (articulos?.Count() ?? 0);
                bool isFirst = true;
            }

            <div class="carousel-indicators mc-indicators">
                @for (int i = 0; i < totalSlides; i++)
                {
                    <button type="button" 
                            data-bs-target="#carouselMeteor" 
                            data-bs-slide-to="@i" 
                            class="@(i == 0 ? "active" : "")"
                            aria-current="@(i == 0 ? "true" : "false")">
                    </button>
                }
            </div>

            <div class="carousel-inner mc-carousel-inner">
                @* Bucle de Productos *@
                @if (productos != null && productos.Any())
                {
                    @foreach (var prod in productos)
                    {
                        <div class="carousel-item mc-carousel-item @(isFirst ? "active" : "")">
                            <a href="/product/@prod.Id" class="mc-carousel-img-wrap">
                                <img src="@prod.Poster" class="d-block w-100" alt="@prod.Title">
                            </a>
                            <div class="mc-carousel-caption">
                                <div class="mc-caption-content">
                                    <p class="mc-caption-text">@prod.Description</p>
                                </div>
                            </div>
                        </div>
                        { isFirst = false; } 
                    }
                }

                @* Bucle de Artículos *@
                @if (articulos != null && articulos.Any())
                {
                    @foreach (var article in articulos)
                    {
                        <div class="carousel-item mc-carousel-item @(isFirst ? "active" : "")">
                            <a href="/article/@article.Id" class="mc-carousel-img-wrap">
                                <img src="@article.FirstImageUrl" class="d-block w-100" alt="@article.Title">
                            </a>
                            <div class="mc-carousel-caption">
                                <div class="mc-caption-content">
                                    <p class="mc-caption-text">@article.Description</p>
                                </div>
                            </div>
                        </div>
                        { isFirst = false; }
                    }
                }
            </div>

            <button class="carousel-control-prev mc-carousel-ctrl" type="button" data-bs-target="#carouselMeteor" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next mc-carousel-ctrl" type="button" data-bs-target="#carouselMeteor" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </button>
        </div>
    </section>

    <div class="container mc-container-mw">
        <!-- ABOUT / NOSOTROS -->
        <section id="about" class="mc-section">
            
            <!-- INTRO NOSOTROS -->
            <div class="row align-items-center mb-5 mc-about-intro">
                
                <div class="col-12 col-md-8">
                    <h2 class="mc-section-title">OUR TEAM</h2>
                    <div class="mc-title-accent mb-4"></div>
                    <p class="mc-text-muted">
                        Meteor Craftworks team is composed of talented young men dedicated to the making of stunning and transcendental works of art that inspire generations just as we have been inspired by who came before us.
                    </p>
                </div>
                <div class="col-12 col-md-4 text-center text-md-start mb-4 mb-md-0">
                    <img src="/imgs/logo.png" class="img-fluid mc-about-logo" alt="Meteor Craftworks logo">
                </div>
            </div>

            <!-- GRILLA DEVS -->
            <div class="row g-4">
                <!-- DEV ANGRI -->
                <div class="col-12 col-lg-6">
                    <div class="mc-dev-card">
                        <img src="/imgs/pic-devs/pic-angry.png" class="mc-dev-img" alt="Lucas Angriman">
                        <div class="mc-dev-info">
                            <h5 class="mc-dev-name">Lucas Angriman</h5>
                            <span class="mc-dev-role">Art Director & Producer</span>
                            <p class="mc-dev-desc">Team Leader<br />3D Artist<br />VFX Expert</p>
                        </div>
                    </div>
                </div>

                <!-- DEV LULO -->
                <div class="col-12 col-lg-6">
                    <div class="mc-dev-card">
                        <img src="/imgs/pic-devs/pic-lulo.png" class="mc-dev-img" alt="Julian Bridi">
                        <div class="mc-dev-info">
                            <h5 class="mc-dev-name">Julian Bridi</h5>
                            <span class="mc-dev-role">CEO & General Producer</span>
                            <p class="mc-dev-desc">Team Coordinator<br />Game Designer<br />Public Relationships</p>
                        </div>
                    </div>
                </div>

                <!-- DEV YO -->
                <div class="col-12 col-lg-6">
                    <div class="mc-dev-card">
                        <img src="/imgs/pic-devs/pic-yo.png" class="mc-dev-img" alt="Ignacio Garcés">
                        <div class="mc-dev-info">
                            <h5 class="mc-dev-name">Ignacio Garcés</h5>
                            <span class="mc-dev-role">COO & Programmer</span>
                            <p class="mc-dev-desc">Product Coordinator<br />Sound Designer<br />Game Development</p>
                        </div>
                    </div>
                </div>

                <!-- DEV MATIAS -->
                <div class="col-12 col-lg-6">
                    <div class="mc-dev-card">
                        <img src="/imgs/pic-devs/pic-mati.png" class="mc-dev-img" alt="Matias Somma">
                        <div class="mc-dev-info">
                            <h5 class="mc-dev-name">Matias Somma</h5>
                            <span class="mc-dev-role">Programmer</span>
                            <p class="mc-dev-desc">Game Developer<br />Asset Implementation<br />Mechanic Engineer</p>
                        </div>
                    </div>
                </div>

                <!-- DEV VALEN -->
                <div class="col-12 col-lg-6">
                    <div class="mc-dev-card">
                        <img src="/imgs/pic-devs/pic-valen.png" class="mc-dev-img" alt="Valentin Quetto">
                        <div class="mc-dev-info">
                            <h5 class="mc-dev-name">Valentin Quetto</h5>
                            <span class="mc-dev-role">3D Artist & Animator</span>
                            <p class="mc-dev-desc">Character Design and Model<br />Character Animations<br />Inorganic Modeling</p>
                        </div>
                    </div>
                </div>

                <!-- DEV AaRON -->
                <div class="col-12 col-lg-6">
                    <div class="mc-dev-card">
                        <img src="/imgs/pic-devs/pic-aron.png" class="mc-dev-img" alt="Arón Poiesis">
                        <div class="mc-dev-info">
                            <h5 class="mc-dev-name">Aaron Poiesis</h5>
                            <span class="mc-dev-role">Musician & CM</span>
                            <p class="mc-dev-desc">Musicalization<br />Content Creation</p>
                        </div>
                    </div>
                </div>

                <!-- DEV JULI -->
                <div class="col-12 col-lg-6">
                    <div class="mc-dev-card">
                        <img src="/imgs/pic-devs/pic-juli.png" class="mc-dev-img" alt="Julieta Mayorga Alvarez">
                        <div class="mc-dev-info">
                            <h5 class="mc-dev-name">Julieta Mayorga Alvarez</h5>
                            <span class="mc-dev-role">2D Artist</span>
                            <p class="mc-dev-desc">Illustration<br />Texturing</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- CONTACTO -->
        <section id="contacto" class="mc-section">
            <div class="row mc-contact-wrap">
                <!-- TEXTO CONTACTO -->
                <div class="col-12 col-md-5 mb-5 mb-md-0 pe-md-5">
                    <h2 class="mc-section-title">Reach out<br /></h2>
                    <p class="mc-text-lavender mt-3">
                        ¿Ready to start your next project?<br>
                        We specialize in turning ideas into unique visual experiences.
                    </p>
                </div>

                <!-- FORMULARIO -->
                <div class="col-12 col-md-7">
                    <EditForm Model="form" OnValidSubmit="EnviarFormulario" FormName="contactForm" class="mc-form">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger mb-3" />

                        <div class="mb-4">
                            <label class="mc-form-label">Name</label>
                            <InputText @bind-Value="form.Nombre" name="Nombre" class="form-control mc-input" />
                        </div>

                        <div class="mb-4">
                            <label class="mc-form-label">E-mail</label>
                            <InputText @bind-Value="form.Email" name="Email" type="email" class="form-control mc-input" />
                        </div>

                        <div class="mb-5">
                            <label class="mc-form-label">Message</label>
                            <InputTextArea @bind-Value="form.Mensaje" name="Mensaje" class="form-control mc-input" rows="1" />
                        </div>

                        <div class="d-flex justify-content-start">
                            <button type="submit" class="mc-btn-submit" disabled="@enviando">
                                @(enviando ? "SENDING..." : "SEND")
                            </button>
                        </div>
                    </EditForm>

                    @if (enviado)
                    {
                        <div class="alert alert-success mt-4 mc-alert">
                            ¡Thanks! Your message was send succesfully.
                        </div>
                    }
                </div>
            </div>
        </section>
    </div>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("initActiveSections");
            await JS.InvokeVoidAsync("enableNavScroll");
            await JS.InvokeVoidAsync("scrollToHash");
            
            // Suscribirse al evento de navegación
            Nav.LocationChanged += OnLocationChanged;
        }
    }

    private IEnumerable<ArticleModel> articulos = Array.Empty<ArticleModel>();
    private IEnumerable<ProductModel> productos = Array.Empty<ProductModel>();

    protected override void OnInitialized()
    {
        articulos = ArticleService.GetAll();
        productos = ProductService.GetAll(); 
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _ = HandleLocationChangedAsync(e);
    }

    private async Task HandleLocationChangedAsync(LocationChangedEventArgs e)
    {
        try
        {
            await JS.InvokeVoidAsync("scrollToHash");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error en scroll: {ex.Message}");
        }
    }

    public void Dispose()
    {
        // Desuscribirse para evitar fugas de memoria
        Nav.LocationChanged -= OnLocationChanged;
    }

    // --- LÓGICA DEL FORMULARIO DE CONTACTO ---

    private ContactFormModel form = new();
    private bool enviando = false;
    private bool enviado = false;

    private async Task EnviarFormulario()
    {
        enviando = true;
        enviado = false;

        try
        {
            // REEMPLAZA ESTE ID con el que te dé Formspree.io
            string formspreeUrl = "https://formspree.io/f/xeeveznn";

            var response = await Http.PostAsJsonAsync(formspreeUrl, form);

            if (response.IsSuccessStatusCode)
            {
                enviado = true;
                form = new ContactFormModel(); // Limpia el formulario
            }
            else
            {
                Console.WriteLine("Error al enviar el formulario a Formspree");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error de red: {ex.Message}");
        }
        finally
        {
            enviando = false;
            StateHasChanged();
        }
    }
}