                    </p>
                </div>
                <div class="col-12 col-md-4 text-center text-md-start mb-4 mb-md-0">
                    <img src="/imgs/logo.png" class="img-fluid mc-about-logo" alt="Meteor Craftworks logo">
                </div>
            </div>

            <!-- GRILLA DEVS -->
            <div class="row g-4">
                <!-- DEV ANGRI -->
                <div class="col-12 col-lg-6">
                    <div class="mc-dev-card">
                        <img src="/imgs/pic-devs/pic-angry.png" class="mc-dev-img" alt="Lucas Angriman">
                        <div class="mc-dev-info">
                            <h5 class="mc-dev-name">Lucas Angriman</h5>
                            <span class="mc-dev-role">Art Director & Producer</span>
                            <p class="mc-dev-desc">Team Leader<br />3D Artist<br />VFX Expert</p>
                        </div>
                    </div>
                </div>
                
                <!-- DEV LULO -->
                <div class="col-12 col-lg-6">
                    <div class="mc-dev-card">
                        <img src="/imgs/pic-devs/pic-lulo.png" class="mc-dev-img" alt="Julian Bridi">
                        <div class="mc-dev-info">
                            <h5 class="mc-dev-name">Julian Bridi</h5>
                            <span class="mc-dev-role">CEO & General Producer</span>
                            <p class="mc-dev-desc">Team Coordinator<br />Game Designer<br />Public Relationships</p>
                        </div>
                    </div>
                </div>

                <!-- DEV YO -->
                <div class="col-12 col-lg-6">
                    <div class="mc-dev-card">
                        <img src="/imgs/pic-devs/pic-yo.png" class="mc-dev-img" alt="Ignacio Garcés">
                        <div class="mc-dev-info">
                            <h5 class="mc-dev-name">Ignacio Garcés</h5>
                            <span class="mc-dev-role">COO & Programmer</span>
                            <p class="mc-dev-desc">Product Coordinator<br />Sound Designer<br />Game Development</p>
                        </div>
                    </div>
                </div>

                <!-- DEV MATIAS -->
                <div class="col-12 col-lg-6">
                    <div class="mc-dev-card">
                        <img src="/imgs/pic-devs/pic-mati.png" class="mc-dev-img" alt="Matias Somma">
                        <div class="mc-dev-info">
                            <h5 class="mc-dev-name">Matias Somma</h5>
                            <span class="mc-dev-role">Programmer</span>
                            <p class="mc-dev-desc">Game Developer<br />Asset Implementation<br />Mechanic Engineer</p>
                        </div>
                    </div>
                </div>

                <!-- DEV VALEN -->
                <div class="col-12 col-lg-6">
                    <div class="mc-dev-card">
                        <img src="/imgs/pic-devs/pic-valen.png" class="mc-dev-img" alt="Valentin Quetto">
                        <div class="mc-dev-info">
                            <h5 class="mc-dev-name">Valentin Quetto</h5>
                            <span class="mc-dev-role">3D Artist & Animator</span>
                            <p class="mc-dev-desc">Character Design and Model<br />Character Animations<br />Inorganic Modeling</p>
                        </div>
                    </div>
                </div>

                <!-- DEV AaRON -->
                <div class="col-12 col-lg-6">
                    <div class="mc-dev-card">
                        <img src="/imgs/pic-devs/pic-aron.png" class="mc-dev-img" alt="Arón Poiesis">
                        <div class="mc-dev-info">
                            <h5 class="mc-dev-name">Aaron Poiesis</h5>
                            <span class="mc-dev-role">Musician & CM</span>
                            <p class="mc-dev-desc">Musicalization<br />Content Creation</p>
                        </div>
                    </div>
                </div>

                <!-- DEV JULI -->
                <div class="col-12 col-lg-6">
                    <div class="mc-dev-card">
                        <img src="/imgs/pic-devs/pic-juli.png" class="mc-dev-img" alt="Julieta Mayorga Alvarez">
                        <div class="mc-dev-info">
                            <h5 class="mc-dev-name">Julieta Mayorga Alvarez</h5>
                            <span class="mc-dev-role">2D Artist</span>
                            <p class="mc-dev-desc">Illustration<br />Texturing</p>
                        </div>
