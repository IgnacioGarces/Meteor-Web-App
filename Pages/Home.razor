@page "/"
@using Meteor_Web_App.Models
@using Meteor_Web_App.Services
@using System.ComponentModel.DataAnnotations
@implements IDisposable
@inject ArticleService ArticleService
@inject ProductService ProductService
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="home-container">

    <!-- 1. HERO BANNER RESPONSIVE -->
    <section id="inicio" class="mc-hero-banner">
        <!-- Fondo diagonal (cambia de vertical a horizontal según pantalla) -->
        <div class="mc-hero-diagonal-bg"></div>
        
        <div class="container mc-container-mw position-relative z-2">
            <div class="row align-items-center">
                
                <!-- Bloque 1: Texto (Arriba en mobile / Izquierda en desktop) -->
                <div class="col-12 col-lg-5 mc-hero-text-col">
                    <h1 class="mc-hero-title">WELCOME TO<br />METEOR</h1>
                    <h2 class="mc-hero-subtitle">Crafting unique experiences</h2>
                    <p class="mc-hero-desc mb-0">
                        We are an independent creative studio dedicated to game development, 3D art, animation, and interactive visual storytelling.
                    </p>
                </div>

                <!-- Bloque 2: Logo Principal (Abajo en mobile / Derecha en desktop) -->
                <div class="col-12 col-lg-7 mc-hero-brand-col">
                    <div class="mc-hero-brand">
                        <img src="/imgs/logo.png" alt="Meteor Craftwork Isotipo" class="mc-hero-isotipo" />
                        <div class="mc-hero-wordmark">
                            <span class="mc-brand-main">METEOR</span>
                            <span class="mc-brand-sub">CRAFTWORK</span>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- 2. LOGOS DE PROYECTOS EN FILA (NUEVO) -->
    <section id="proyectos-logos" class="mc-projects-strip">
        <div class="container mc-container-mw">
            <div class="d-flex flex-wrap justify-content-center align-items-center gap-4 gap-md-5">
                
                @* OPCIÓN A: Dinámico desde tu ProductService (si cada producto tiene su logo/poster) *@
                @if (productos != null && productos.Any())
                {
                    @foreach (ProductModel prod in productos)
                    {
                        <a href="/product/@prod.Id" class="mc-project-logo-link" title="@prod.Title">
                            <img src="@prod.Poster" alt="@prod.Title" class="mc-project-logo-img" />
                        </a>
                    }
                }
                else
                {
                    @* OPCIÓN B: Estático (como en el diseño de la artista) *@
                    <a href="/proyectos/infinite-football" class="mc-project-logo-link">
                        <img src="/imgs/logos-proyectos/infinite-football.png" alt="Infinite Football" class="mc-project-logo-img" />
                    </a>
                    <a href="/proyectos/tribulation" class="mc-project-logo-link">
                        <img src="/imgs/logos-proyectos/tribulation.png" alt="Tribulation of the Realms" class="mc-project-logo-img" />
                    </a>
                    <a href="/proyectos/mate-aventuras" class="mc-project-logo-link">
                        <img src="/imgs/logos-proyectos/mate-aventuras.png" alt="Mate Aventuras" class="mc-project-logo-img" />
                    </a>
                }
            </div>
        </div>
    </section>

    <div class="container mc-container-mw">
        
        <!-- 3. NUESTROS SERVICIOS (NUEVO) -->
        <section id="servicios" class="mc-section pb-4">
            <h2 class="mc-section-title">SERVICES WE PROVIDE</h2>
            <div class="mc-title-accent mb-5"></div>

            <div class="row g-4">
                <!-- Servicio 1: Game Dev -->
                <div class="col-12 col-md-6">
                    <a href="/servicios/gamedev" class="mc-service-btn">
                        <span class="mc-service-label">Game Development</span>
                        <!-- Ícono Joystick SVG -->
                        <svg class="mc-service-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 9h.01M18 11h.01M7 10h2m-1-1v2m-3.5 6.5a3.5 3.5 0 01-3.4-4.3l1.1-4.5A4 4 0 016.1 6h11.8a4 4 0 013.9 3.2l1.1 4.5a3.5 3.5 0 01-3.4 4.3c-1.4 0-2.6-.8-3.2-2l-.6-1.2a1.5 1.5 0 00-1.3-.8h-4.8a1.5 1.5 0 00-1.3.8l-.6 1.2c-.6 1.2-1.8 2-3.2 2z" />
                        </svg>
                    </a>
                </div>

                <!-- Servicio 2: Animación / Video -->
                <div class="col-12 col-md-6">
                    <a href="/servicios/animation" class="mc-service-btn">
                        <span class="mc-service-label">2D & 3D Animation</span>
                        <!-- Ícono Claqueta SVG -->
                        <svg class="mc-service-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l16-4 1.5 5.5L4.5 13.5 3 8zm1.5 5.5H20v6.5a2 2 0 01-2 2H6.5a2 2 0 01-2-2v-6.5zm6 2v3l3-1.5-3-1.5z" />
                        </svg>
                    </a>
                </div>

                <!-- Servicio 3: Modelado 3D -->
                <div class="col-12 col-md-6">
                    <a href="/servicios/3d-modeling" class="mc-service-btn">
                        <span class="mc-service-label">3D Modeling & VFX</span>
                        <!-- Ícono Esfera 3D SVG -->
                        <svg class="mc-service-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                            <circle cx="12" cy="12" r="9" />
                            <path stroke-linecap="round" d="M12 3c2.5 2.5 4 5.5 4 9s-1.5 6.5-4 9" />
                            <text x="6.5" y="14.5" font-size="6" fill="currentColor" stroke="none" font-weight="bold">3D</text>
                        </svg>
                    </a>
                </div>

                <!-- Servicio 4: Arte 2D / Ilustración -->
                <div class="col-12 col-md-6">
                    <a href="/servicios/illustration" class="mc-service-btn">
                        <span class="mc-service-label">2D Art & Concept</span>
                        <!-- Ícono Pincel SVG -->
                        <svg class="mc-service-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M18.37 2.63L14 7l-1.59-1.59a2 2 0 00-2.82 0L8 7l9 9 1.59-1.59a2 2 0 000-2.82L17 10l4.37-4.37a2.12 2.12 0 10-3-3zM9 8c-2 3-4 3.5-7 4l8 10c2-1 6-5 6-7" />
                        </svg>
                    </a>
                </div>
            </div>
        </section>

        <!-- ABOUT / NOSOTROS (Tu código original intacto) -->
