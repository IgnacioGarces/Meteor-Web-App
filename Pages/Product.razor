@page "/product/{Id:int}"
@using Meteor_Web_App.Models
@using Meteor_Web_App.Services
@inject ProductService ProductService
@inject ArticleService ArticleService

<div class="mc-product-page">
    <div class="container mc-container-mw">

        <!-- Navegación rápida de regreso -->
        <div class="mb-4">
            <a href="/" class="mc-back-link">
                <i class="bi bi-arrow-left"></i> Volver al inicio
            </a>
        </div>

        @if (product is null)
        {
            <PageTitle>Producto no encontrado - Meteor Craftwork</PageTitle>
            <div class="text-center py-5">
                <h2 class="mc-section-title">Producto no encontrado</h2>
                <p class="mc-text-muted mt-2">El proyecto que buscas no está disponible o fue movido.</p>
                <a href="/" class="mc-btn-submit d-inline-block mt-3 text-decoration-none">Volver al inicio</a>
            </div>
        }
        else
        {
            <PageTitle>@product.Title - Meteor Craftwork</PageTitle>

            <section class="mc-product-showcase">
                <div class="row g-4 g-lg-5 align-items-start">

                    <!-- IZQUIERDA: GALERÍA MULTIMEDIA -->
                    <div class="col-12 col-lg-8">
                        @if (product.Images != null && product.Images.Any())
                        {
                            <!-- Se agrega data-bs-toggle="modal" al carrusel entero para abrirlo con un clic -->
                            <div id="productCarousel" class="carousel slide mc-product-carousel" data-bs-ride="carousel" 
                                 data-bs-toggle="modal" data-bs-target="#fullscreenModal" style="cursor: pointer;">

                                <!-- Ícono indicador de expansión (visible sobre la imagen) -->
                                <div class="mc-expand-indicator">
                                    <i class="bi bi-arrows-angle-expand"></i>
                                </div>

                                <!-- Indicadores -->
                                <div class="carousel-indicators mc-indicators">
                                    @for (int i = 0; i < product.Images.Count; i++)
                                    {
                                        <button type="button"
                                                data-bs-target="#productCarousel"
                                                data-bs-slide-to="@i"
                                                class="@(i == 0 ? "active" : "")"
                                                aria-current="@(i == 0 ? "true" : "false")"
                                                aria-label="Slide @(i + 1)"
                                                @onclick:stopPropagation="true"> 
                                                <!-- detiene el clic para que los indicadores no abran el modal -->
                                        </button>
                                    }
                                </div>

                                <!-- Slides -->
                                <div class="carousel-inner mc-product-carousel-inner">
                                    @for (int i = 0; i < product.Images.Count; i++)
                                    {
                                        // Usamos onclick para sincronizar el modal con la imagen clickeada
                                        int slideIndex = i;
                                        <div class="carousel-item mc-product-carousel-item @(i == 0 ? "active" : "")" 
                                             onclick="$('#fullscreenCarousel').carousel(@slideIndex)">
                                            <div class="mc-product-img-wrapper">
                                                <img src="@product.Images[i]"
                                                     class="mc-product-carousel-img"
                                                     alt="@product.Title - imagen @(i + 1)" />
                                            </div>
                                        </div>
                                    }
                                </div>

                                <!-- Controles -->
                                <button class="carousel-control-prev mc-carousel-ctrl" type="button" data-bs-target="#productCarousel" data-bs-slide="prev" @onclick:stopPropagation="true">
                                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                    <span class="visually-hidden">Anterior</span>
                                </button>
                                <button class="carousel-control-next mc-carousel-ctrl" type="button" data-bs-target="#productCarousel" data-bs-slide="next" @onclick:stopPropagation="true">
                                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                    <span class="visually-hidden">Siguiente</span>
                                </button>
                            </div>

                            <!-- Tira de miniaturas -->
                            <div class="mc-thumbnail-strip mt-3">
                                @for (int i = 0; i < product.Images.Count; i++)
                                {
                                    <button type="button"
                                            class="mc-thumb-btn"
                                            data-bs-target="#productCarousel"
                                            data-bs-slide-to="@i"
                                            aria-label="Ver imagen @(i + 1)">
                                        <img src="@product.Images[i]"
                                             class="mc-thumbnail"
                                             alt="Thumbnail @(i + 1)" />
                                    </button>
                                }
                            </div>
                        }

                    </div>

                    <!-- DERECHA: FICHA TÉCNICA Y ACCIÓN (Sin cambios) -->
                    <div class="col-12 col-lg-4">
                        <aside class="mc-product-sidebar">
                            @if (!string.IsNullOrEmpty(product.Poster))
                            {
                                <div class="mc-poster-wrap mb-4">
                                    <img src="@product.Poster" class="mc-product-poster" alt="@product.Title Poster" />
                                </div>
                            }
                            <h1 class="mc-product-title">@product.Title</h1>
                            <div class="mc-title-accent mb-3"></div>
                            @if (!string.IsNullOrEmpty(product.Description))
                            {
                                <p class="mc-product-description">@product.Description</p>
                            }
                            @if (product.ReleaseDate.HasValue)
                            {
                                <div class="mc-product-meta">
                                    <span class="mc-meta-label">RELEASE DATE</span>
                                    <span class="mc-meta-value">@product.ReleaseDate.Value.ToString("dd MMM yyyy")</span>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(product.StoreUrl))
                            {
                                <a href="@product.StoreUrl" target="_blank" rel="noopener noreferrer" class="mc-btn-product-cta mt-4">
                                    <span>Product Page</span>
                                    <i class="bi bi-box-arrow-up-right"></i>
                                </a>
                            }
                        </aside>
                    </div>
                </div>

            </section>

            @if (linkedArticle != null)
            {
                <section class="mc-product-article-section mt-5 pt-5">
                    <div class="mc-article-centered-wrap">
                        <ArticleContent Article="@linkedArticle" />
                    </div>
                </section>
            }

            <!-- ============================================== -->
            <!-- MODAL FULLSCREEN PARA IMÁGENES                 -->
            <!-- ============================================== -->
            <div class="modal fade mc-fullscreen-modal" id="fullscreenModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-fullscreen">
                    <div class="modal-content mc-modal-content">
                        
                        <!-- Botón de cierre superior -->
                        <button type="button" class="mc-modal-close" data-bs-dismiss="modal" aria-label="Cerrar">
                            <i class="bi bi-x-lg"></i>
                        </button>

                        <div class="modal-body p-0">
                            <!-- Carrusel Interno del Modal (Sin auto-play) -->
                            <div id="fullscreenCarousel" class="carousel slide h-100" data-bs-interval="false">
                                <div class="carousel-inner h-100">
                                    @for (int i = 0; i < product.Images.Count; i++)
                                    {
                                        <div class="carousel-item h-100 @(i == 0 ? "active" : "")">
                                            <div class="mc-fullscreen-img-wrap">
                                                <img src="@product.Images[i]" class="mc-fullscreen-img" alt="@product.Title - Fullscreen @(i + 1)" />
                                            </div>
                                        </div>
                                    }
                                </div>
                                
                                <!-- Controles Modal -->
                                <button class="carousel-control-prev mc-fs-ctrl" type="button" data-bs-target="#fullscreenCarousel" data-bs-slide="prev">
                                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                    <span class="visually-hidden">Anterior</span>
                                </button>
                                <button class="carousel-control-next mc-fs-ctrl" type="button" data-bs-target="#fullscreenCarousel" data-bs-slide="next">
                                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                    <span class="visually-hidden">Siguiente</span>
                                </button>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
            <!-- FIN MODAL -->

        }

    </div>
</div>

@code {
    [Parameter] public int Id { get; set; } = default!;
    private ProductModel? product;
    private ArticleModel? linkedArticle;

    protected override void OnParametersSet()
    {
        product = ProductService.GetById(Id);
        if (product?.ArticleId != null)
        {
            linkedArticle = ArticleService.GetById(product.ArticleId.Value);
        }
        else
        {
            linkedArticle = null;
        }
        StateHasChanged();
    }
}