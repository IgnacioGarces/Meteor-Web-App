@page "/product/{Id:int}"

@using Meteor_Web_App.Models
@using Meteor_Web_App.Services
@inject ProductService ProductService

<PageTitle>@product?.Title</PageTitle>


@if (product is null)
{
    <div class="container mt-5 pt-5">
        <h3>Producto no encontrado</h3>
    </div>
}
else
{
    <section class="product-page container snap-container">
        <div class="product-page snap-section">
            <div class="row g-4   ">

                <!-- LEFT: MEDIA -->
                <div class="product-gallery col-12 col-md-8 col-lg-8 ">

                    <div id="productCarousel"
     class="carousel slide mt-0 mb-3"
     data-bs-ride="carousel">

    <!-- Indicadores dinámicos según la cantidad de imágenes -->
    <div class="carousel-indicators">
        @for (int i = 0; i < product.Images.Count; i++)
        {
            <button type="button"
                    data-bs-target="#productCarousel"
                    data-bs-slide-to="@i"
                    class="@(i == 0 ? "active" : "")"
                    aria-current="@(i == 0 ? "true" : "false")"
                    aria-label="Slide @(i + 1)">
            </button>
        }
    </div>

    <!-- Slides -->
    <div class="carousel-inner rounded overflow-hidden">
        @for (int i = 0; i < product.Images.Count; i++)
        {
            <div class="carousel-item @(i == 0 ? "active" : "")">
                <div class="carousel-img-wrapper">
                    <img src="@product.Images[i]"
                         class="carousel-img"
                         alt="@product.Title - imagen @(i + 1)" />
                </div>
            </div>
        }
    </div>

    <!-- Controles Siguiente / Anterior de Bootstrap -->
    <button class="carousel-control-prev" type="button" data-bs-target="#productCarousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Anterior</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#productCarousel" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Siguiente</span>
    </button>
</div>

<!-- Tira de miniaturas -->
<div class="thumbnail-strip gap-2">
    @for (int i = 0; i < product.Images.Count; i++)
    {
        <img src="@product.Images[i]"
             class="thumbnail"
             data-bs-target="#productCarousel"
             data-bs-slide-to="@i"
             alt="Thumbnail @(i + 1)" />
    }
</div>

                </div>

                <!-- RIGHT: INFO -->
                
                <div class="product-info col-12 col-md-4 col-lg-4 ">
                
                    <img src="@product.Poster"
                         class="product-poster mt-0 mb-3" />
                    <h2 class="product-description title">@product.Title</h2>
                    <p class="product-description">
                        @product.Description
                    </p>
                    @if(product.ReleaseDate.HasValue){

                        <p class="product-description">
                            <strong>Release Date</strong><br />
                            @product.ReleaseDate.Value.ToString("dd MMM yyyy")
                        </p>
                    }
                    @if(product.StoreUrl != null){

                        <a href="@product.StoreUrl"
                        target="_blank"
                        class="btn btn-success btn-lg mt-3">
                            Product Page
                        </a>
                    }
                </div>
                

            </div>
        </div>
    </section>
}

@code {
    [Parameter] public int Id { get; set; } = default!;
    private ProductModel? product;

    protected override void OnParametersSet()
    {
        product = ProductService.GetById(Id);
        
        StateHasChanged();
    }
}