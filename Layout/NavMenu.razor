@using Meteor_Web_App.Models
@using Meteor_Web_App.Services
@implements IDisposable
@inject NavigationManager Nav
@inject ProductService ProductService
@inject IJSRuntime JS

<!-- Aplicamos la clase mc-navbar y ms-auto para empujar los links a la derecha -->
<nav id="mainNavbar" class="navbar navbar-expand-lg mc-navbar fixed-top">
    <div class="container-fluid mc-container-mw">

        <!-- LOGO (Alineado a la izquierda) -->
        <div class="navbar-brand">
            @if (IsHome)
            {
                <a href="/#inicio" @onclick="CloseMobileMenu">
                    <img src="imgs/bannerLogo.png" class="mc-banner-logo" alt="Meteor Craftwork Logo" />
                </a>
            }
            else
            {
                <NavLink href="/" Match="NavLinkMatch.All" @onclick="CloseMobileMenu">
                    <img src="imgs/bannerLogo.png" class="mc-banner-logo" alt="Meteor Craftwork Logo" />
                </NavLink>
            }
        </div>

        <!-- BOTÓN MENÚ MÓVIL (Toggler) -->
        <button class="navbar-toggler mc-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#navbarNav"
                aria-controls="navbarNav"
                aria-expanded="false"
                aria-label="Toggle navigation">
            <span class="navbar-toggler-icon mc-toggler-icon"></span>
        </button>

        <!-- LINKS Y DROPDOWN -->
        <div class="collapse navbar-collapse" id="navbarNav">
            <!-- ms-auto empuja los items a la derecha -->
            <ul class="navbar-nav ms-auto mc-nav-links">

                <!-- 1. LAUNCHS -->
                <li class="nav-item dropdown mc-dropdown">
                    <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        Launchs
                    </a>

                    <ul class="dropdown-menu mc-dropdown-menu" aria-labelledby="navbarDropdown">
                        @if (productos != null)
                        {
                            @foreach (var prod in productos)
                            {
                                var prodLink = "/product/" + prod.Id;
                                <li>
                                    <NavLink class="dropdown-item mc-dropdown-item" href="@prodLink" @onclick="CloseMobileMenu">
                                        @prod.Title
                                    </NavLink>
                                </li>
                            }
                        }
                    </ul>
                </li>

                <!-- 2. SERVICES -->
                <li class="nav-item">
                    <a class="nav-link" href="/#servicios" @onclick='() => NavigateToSection("servicios")' @onclick:preventDefault="IsHome">
                        Services
                    </a>
                </li>

                <!-- 3. CONTACT -->
                <li class="nav-item">
                    <a class="nav-link" href="/#contacto" @onclick='() => NavigateToSection("contacto")' @onclick:preventDefault="IsHome">
                        Contact
                    </a>
                </li>

            </ul>
        </div>
    </div>
</nav>

@code {
    // Verifica si la URL actual es la raíz (ignorando cualquier #hash previo como /#servicios)
    private bool IsHome
    {
        get
        {
            var path = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/');
            var basePath = new Uri(Nav.BaseUri).AbsolutePath.TrimEnd('/');
            return string.Equals(path, basePath, StringComparison.OrdinalIgnoreCase);
        }
    }

    private IEnumerable<ProductModel> productos = Array.Empty<ProductModel>();

    protected override void OnInitialized()
    {
        productos = ProductService.GetAll();
        Nav.LocationChanged += HandleLocationChanged;
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        StateHasChanged();
    }

    private async Task NavigateToSection(string sectionId)
    {
        await CloseMobileMenu();

        if (IsHome)
        {
            // Si ya estamos en la Home, hacemos scroll directo por JS al ID de la sección
            await JS.InvokeVoidAsync("eval", $@"
                var el = document.getElementById('{sectionId}');
                if (el) {{
                    el.scrollIntoView({{ behavior: 'smooth' }});
                }}
            ");
        }
    }

    private async Task CloseMobileMenu()
    {
        try
        {
            await JS.InvokeVoidAsync("eval", @"
                var navCollapse = document.getElementById('navbarNav');
                if (navCollapse && navCollapse.classList.contains('show')) {
                    bootstrap.Collapse.getOrCreateInstance(navCollapse).hide();
                }
            ");
        }
        catch
        {
            // Ignorar si se ejecuta durante prerender
        }
    }

    public void Dispose()
    {
        Nav.LocationChanged -= HandleLocationChanged;
    }
}